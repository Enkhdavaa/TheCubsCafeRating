{
  "imports": {
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@db/sqlite": "jsr:@db/sqlite@^0.13.0",
    "@oak/oak": "jsr:@oak/oak@^17.2.0",
    "bootstrap": "npm:bootstrap@^5.3.8",
    "lit-html": "npm:lit-html@^3.3.3",
    "vite": "npm:vite@^8.3.4"
  },
  "tasks": {
    "dev": "deno run -A npm:vite --host",
    "clean": "rm -rf ./node_modules && rm -rf ./vendor && rm -rf ./.vite && rm -rf ./deno.lock",
    "serve": "deno run --allow-all ./server.ts",
    "build": "deno run -A npm:vite build",
    "check": "deno check server.ts router.ts vite.config.mts src/",
    "migrate": "deno run -A src/db/postgres/migrate.ts"
  },
  "deploy": {
    "install": "deno install",
    "build": "deno task build",
    "predeploy": "deno task migrate",
    "runtime": {
      "entrypoint": "./server.ts"
    }
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"],
    "noImplicitOverride": true,
    "strict": true,
    "useUnknownInCatchVariables": true
  },
  "exclude": [".vite"]
}
